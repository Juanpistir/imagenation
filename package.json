{
  "name": "imagenation",
  "version": "1.0.0",
  "description": "Plataforma de gestión de imágenes con Firebase y Fastify",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.js",
    "start": "bun run src/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch --config jest.config.js",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest test/unit --config jest.config.js",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest test/integration --config jest.config.js",
    "test:upload": "NODE_OPTIONS=--experimental-vm-modules jest test/upload.test.js --config jest.config.js",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --config jest.config.js"
  },
  "dependencies": {
    "@fastify/auth": "^5.0.2",
    "@fastify/compress": "^8.0.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^9.0.3",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "@fastify/view": "^10.0.2",
    "@hapi/boom": "^10.0.1",
    "@types/jest": "^29.5.14",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "firebase": "^11.2.0",
    "firebase-admin": "^13.0.2",
    "handlebars": "^4.7.8",
    "jest": "^29.7.0",
    "node-fetch": "^3.3.2",
    "sharp": "^0.33.5",
    "streamifier": "^0.1.1",
    "supertest": "^7.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@playwright/test": "^1.49.1",
    "babel-jest": "^29.7.0",
    "dependency-cruiser": "^16.9.0",
    "ember-template-lint": "^6.1.0",
    "ember-template-lint-plugin-prettier": "^5.0.0",
    "formdata-node": "^6.0.3",
    "jest-environment-node": "^29.7.0",
    "jest-mock": "^29.7.0"
  }
}
