<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-body">
          <h2 class="text-center mb-4">Iniciar Sesión</h2>
          <form id="loginForm">
            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input type="email" class="form-control" id="email" required>
            </div>
            <div class="mb-3">
              <label for="password" class="form-label">Contraseña</label>
              <input type="password" class="form-control" id="password" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">Iniciar Sesión</button>
          </form>
          <div class="text-center mt-3">
            <p>¿No tienes cuenta? <a href="/register">Regístrate</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Esperar a que Firebase esté listo
function waitForFirebase() {
  return new Promise((resolve) => {
    const checkFirebase = setInterval(() => {
      if (window.firebase && window.auth) {
        clearInterval(checkFirebase);
        resolve();
      }
    }, 100);
  });
}

// Inicializar el formulario
async function initializeLoginForm() {
  await waitForFirebase();
  
  const loginForm = document.getElementById('loginForm');
  const submitButton = loginForm.querySelector('button[type="submit"]');
  let isLoggingIn = false;

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Evitar múltiples intentos de login
    if (isLoggingIn) return;
    isLoggingIn = true;

    // Deshabilitar el botón y mostrar estado de carga
    submitButton.disabled = true;
    submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Iniciando sesión...';

    try {
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;

      // Intentar login
      const success = await window.auth.login(email, password);
      
      if (!success) {
        throw new Error('Error al iniciar sesión');
      }
    } catch (error) {
      console.error('Error en login:', error);
      
      // Mostrar mensaje de error
      await Swal.fire({
        icon: 'error',
        title: 'Error al iniciar sesión',
        text: error.message || 'Ha ocurrido un error inesperado',
        confirmButtonText: 'Entendido'
      });
      
      // Restaurar el formulario
      submitButton.disabled = false;
      submitButton.innerHTML = 'Iniciar Sesión';
      isLoggingIn = false;
    }
  });
}

// Inicializar cuando el DOM esté listo
document.addEventListener('DOMContentLoaded', initializeLoginForm);
</script>
