{{! Página principal }}
<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {{! Mensaje de bienvenida }}
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Bienvenido a Imagenation</h1>
      <p class="text-xl text-gray-600">Tu plataforma para compartir y descubrir imágenes increíbles</p>
    </div>

    {{#if error}}
      <div class="bg-red-100 border-l-4 border-red-500 p-4 mb-8 rounded-r-lg">
        <p class="text-red-700">{{error}}</p>
      </div>
    {{/if}}

    <div class="flex flex-col lg:flex-row gap-8">
      {{! Sección principal con imágenes }}
      <div class="lg:w-2/3 order-2 lg:order-1">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {{#if images.length}}
            {{#each images}}
              <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-200 overflow-hidden">
                <a href="/images/{{this.id}}" class="block">
                  <div class="aspect-w-16 aspect-h-9">
                    <img 
                      src="{{this.imageUrl}}" 
                      alt="{{this.title}}" 
                      class="w-full h-64 object-cover"
                      loading="lazy"
                    >
                  </div>
                  <div class="p-4">
                    <h2 class="text-lg font-semibold text-gray-900 mb-2">{{truncate this.title 50}}</h2>
                    <p class="text-gray-600 text-sm mb-4">{{truncate this.description 100}}</p>
                    <div class="flex items-center justify-between text-sm">
                      <div class="flex items-center space-x-4 text-gray-500">
                        <span title="Vistas" class="flex items-center">
                          <i class="fas fa-eye mr-1"></i>
                          {{this.views}}
                        </span>
                        <span title="Me gusta" class="flex items-center">
                          <i class="fas fa-heart mr-1"></i>
                          {{this.likes}}
                        </span>
                        <span title="Comentarios" class="flex items-center">
                          <i class="fas fa-comment mr-1"></i>
                          {{this.commentCount}}
                        </span>
                      </div>
                      <span class="text-xs text-gray-400">
                        {{formatDate this.timestamp}}
                      </span>
                    </div>
                  </div>
                </a>
              </div>
            {{/each}}
          {{else}}
            <div class="col-span-2">
              <div class="bg-blue-50 border-l-4 border-blue-500 p-6 rounded-r-lg">
                <p class="text-blue-700 text-lg">No hay imágenes aún. ¡Sé el primero en subir una!</p>
              </div>
            </div>
          {{/if}}
        </div>
      </div>

      {{! Barra lateral }}
      <div class="lg:w-1/3 order-1 lg:order-2">
        {{#if user}}
          {{> upload-form}}
        {{else}}
          {{> login-prompt}}
        {{/if}}

        <div class="bg-white rounded-lg shadow-md p-4">
          <h2 class="text-lg font-bold text-gray-800 mb-2">Estadísticas</h2>
          <p class="text-gray-600">Total de imágenes: {{images.length}}</p>
          <p class="text-gray-600">Total de likes: {{totalLikes}}</p>
          <p class="text-gray-600">Total de vistas: {{totalViews}}</p>
        </div>
      </div>
    </div>
  </div>
</div>