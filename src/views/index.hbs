<div class="row">
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h3 class="h5 mb-0"><i class="fas fa-upload me-2"></i>Subir imagen</h3>
            </div>
            <div class="card-body">
                <form action="/images" method="POST" enctype="multipart/form-data">
                    <div class="mb-3">
                        <input type="text" name="title" class="form-control" placeholder="Título de la imagen" required>
                    </div>
                    <div class="mb-3">
                        <textarea name="description" rows="2" class="form-control" placeholder="Descripción de la imagen" required></textarea>
                    </div>
                    <div class="mb-3">
                        <input type="file" name="image" class="form-control" accept="image/*" required>
                    </div>
                    <button class="btn btn-primary w-100">
                        <i class="fas fa-cloud-upload-alt me-2"></i>Subir
                    </button>
                </form>
            </div>
        </div>
        {{> stats}}
    </div>
    
    <div class="col-md-8">
        <h2 class="mb-4"><i class="far fa-images me-2"></i>Galería reciente</h2>
        <div class="card-columns">
            {{#each images}}
                {{> image-card this}}
            {{else}}
                <div class="alert alert-info"></div>
                    <i class="fas fa-info-circle me-2"></i>No hay imágenes aún
                </div>
            {{/each}}
        </div>
    </div>
</div>