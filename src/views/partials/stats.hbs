<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">
            <i class="fas fa-chart-bar me-2"></i>Estadísticas
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <h6>Imágenes:</h6>
                <p>{{images.length}}</p>
            </div>
            <div class="col-md-4">
                <h6>Vistas:</h6>
                <p>{{views}}</p>
            </div>
            <div class="col-md-4">
                <h6>Comentarios:</h6>
                <p>{{comments}}</p>
            </div>
        </div>
    </div>
</div>
