<div class="card mb-4">
    <a href="/images/{{id}}" class="text-decoration-none">
        <img src="{{imageUrl}}" alt="{{title}}" class="card-img-top" loading="lazy">
        <div class="card-body">
            <h5 class="card-title text-dark">{{title}}</h5>
            {{#if description}}
            <p class="card-text text-muted">{{description}}</p>
            {{/if}}
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">{{timeago timestamp}}</small>
                <div>
                    <span class="me-2"><i class="fas fa-eye text-info"></i> {{views}}</span>
                    <span><i class="fas fa-heart text-danger"></i> {{likes}}</span>
                </div>
            </div>
        </div>
    </a>
</div>
