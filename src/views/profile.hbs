{{!-- Vista de Perfil --}}
<div class="min-h-screen bg-gray-50" 
     x-data 
     x-init="$store.profile.init()">
    {{!-- Banner y Perfil Header --}}
    <div class="relative">
        {{!-- Banner --}}
        <div class="h-80 w-full overflow-hidden">
            <template x-if="$store.profile.profile.bannerURL">
                <img :src="$store.profile.profile.bannerURL" 
                     :alt="'Banner de ' + $store.profile.profile.displayName"
                     class="w-full h-full object-cover">
            </template>
            <template x-if="!$store.profile.profile.bannerURL">
                <div class="w-full h-full bg-gradient-to-r from-blue-500 to-purple-600"></div>
            </template>
        </div>

        {{!-- Información del Perfil --}}
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="relative -mt-32">
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <div class="sm:flex sm:items-center sm:justify-between">
                        {{!-- Avatar y Nombre --}}
                        <div class="sm:flex sm:space-x-5">
                            <div class="flex-shrink-0">
                                <template x-if="$store.profile.profile.photoURL">
                                    <img class="mx-auto h-32 w-32 rounded-full border-4 border-white shadow-lg object-cover"
                                         :src="$store.profile.profile.photoURL" 
                                         :alt="$store.profile.profile.displayName">
                                </template>
                                <template x-if="!$store.profile.profile.photoURL && $store.profile.profile.displayName">
                                    <div class="mx-auto h-32 w-32 rounded-full border-4 border-white shadow-lg bg-primary text-white flex items-center justify-center text-4xl font-medium uppercase">
                                        <span x-text="$store.profile.profile.displayName.charAt(0)"></span>
                                    </div>
                                </template>
                            </div>
                            <div class="mt-4 sm:mt-0 sm:pt-1 sm:text-left">
                                <p class="text-sm text-gray-600" x-text="'@' + $store.profile.profile.username"></p>
                                <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl" x-text="$store.profile.profile.displayName"></h1>
                                <p class="text-gray-600 mt-2" x-text="$store.profile.profile.bio"></p>
                            </div>
                        </div>

                        {{!-- Botones de Acción --}}
                        <div class="mt-5 flex justify-center sm:mt-0">
                            {{#if (eq user.uid profile.uid)}}
                                <button @click="$store.profile.startEditing()" 
                                        class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                                    <i class="fas fa-edit mr-2"></i>
                                    Editar Perfil
                                </button>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{!-- Tabs Navigation --}}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
        <div class="border-b border-gray-200">
            <nav class="-mb-px flex space-x-8" aria-label="Tabs">
                <button 
                    @click="$store.profile.setActiveTab('posts')"
                    :class="$store.profile.activeTab === 'posts' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'"
                    class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                    Publicaciones
                </button>
                <button 
                    @click="$store.profile.setActiveTab('likes')"
                    :class="$store.profile.activeTab === 'likes' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'"
                    class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                    Me gusta
                </button>
                <button 
                    @click="$store.profile.setActiveTab('collections')"
                    :class="$store.profile.activeTab === 'collections' ? 'border-primary text-primary' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'"
                    class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                    Colecciones
                </button>
            </nav>
        </div>

        {{!-- Tab Content --}}
        <div class="mt-8">
            {{!-- Posts Tab --}}
            <div x-show="$store.profile.activeTab === 'posts'" x-transition>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                    <template x-for="image in $store.profile.profile.images" :key="image.id">
                        <a :href="'/images/' + image.id" class="block">
                            <div class="aspect-w-1 aspect-h-1 w-full overflow-hidden rounded-lg bg-gray-200">
                                <img :src="image.mainImageUrl" 
                                     :alt="image.title"
                                     class="h-full w-full object-cover transform transition-all duration-300 hover:scale-105">
                            </div>
                        </a>
                    </template>
                </div>
            </div>

            {{!-- Likes Tab --}}
            <div x-show="$store.profile.activeTab === 'likes'" x-transition>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                    <template x-for="image in $store.profile.likedImages" :key="image.id">
                        <a :href="'/images/' + image.id" class="block">
                            <div class="aspect-w-1 aspect-h-1 w-full overflow-hidden rounded-lg bg-gray-200">
                                <img :src="image.mainImageUrl" 
                                     :alt="image.title"
                                     class="h-full w-full object-cover transform transition-all duration-300 hover:scale-105">
                            </div>
                        </a>
                    </template>
                </div>
            </div>

            {{!-- Collections Tab --}}
            <div x-show="$store.profile.activeTab === 'collections'" x-transition>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <template x-for="collection in $store.profile.collections" :key="collection.id">
                        <div class="bg-white rounded-lg shadow p-4">
                            <h3 class="text-lg font-semibold mb-2" x-text="collection.name"></h3>
                            <div class="grid grid-cols-3 gap-2">
                                <template x-for="image in collection.images.slice(0, 3)" :key="image.id">
                                    <div class="aspect-square overflow-hidden rounded">
                                        <img :src="image.mainImageUrl" 
                                             :alt="image.title"
                                             class="w-full h-full object-cover">
                                    </div>
                                </template>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </div>

    {{!-- Modal de Edición --}}
    <div x-show="$store.profile.isEditing" 
         class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50"
         x-transition>
        <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
            <div class="mt-3">
                <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">Editar Perfil</h3>
                
                {{!-- Mensaje de Error --}}
                <div x-show="$store.profile.error" 
                     class="mb-4 p-2 bg-red-100 border border-red-400 text-red-700 rounded">
                    <span x-text="$store.profile.error"></span>
                </div>

                {{!-- Formulario --}}
                <form @submit.prevent="$store.profile.saveProfile()">
                    {{!-- Nombre --}}
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700">Nombre</label>
                        <input type="text" 
                               x-model="$store.profile.formData.displayName"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm"
                               required>
                    </div>

                    {{!-- Username --}}
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700">Username</label>
                        <div class="mt-1 relative">
                            <input type="text" 
                                   x-model="$store.profile.formData.username"
                                   @input.debounce.300ms="$store.profile.checkUsername($event.target.value)"
                                   class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm"
                                   :class="{ 'border-red-500': !$store.profile.usernameAvailable }"
                                   required>
                            <div class="absolute inset-y-0 right-0 flex items-center pr-3">
                                <template x-if="$store.profile.usernameChecking">
                                    <svg class="animate-spin h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                </template>
                                <template x-if="!$store.profile.usernameChecking && $store.profile.formData.username">
                                    <i :class="{
                                        'fas fa-check text-green-500': $store.profile.usernameAvailable,
                                        'fas fa-times text-red-500': !$store.profile.usernameAvailable
                                    }"></i>
                                </template>
                            </div>
                        </div>
                        <p x-show="!$store.profile.usernameAvailable" 
                           class="mt-1 text-sm text-red-600">
                            Este username ya está en uso
                        </p>
                    </div>

                    {{!-- Biografía --}}
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700">Biografía</label>
                        <textarea x-model="$store.profile.formData.bio"
                                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm"
                                  rows="3"></textarea>
                    </div>

                    {{!-- Avatar --}}
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700">Foto de Perfil</label>
                        <input type="file" 
                               @change="$store.profile.handleFileChange($event, 'photo')"
                               accept="image/*"
                               class="mt-1 block w-full text-sm text-gray-500
                                      file:mr-4 file:py-2 file:px-4
                                      file:rounded-full file:border-0
                                      file:text-sm file:font-semibold
                                      file:bg-primary file:text-white
                                      hover:file:bg-primary-dark">
                    </div>

                    {{!-- Banner --}}
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700">Banner</label>
                        <input type="file" 
                               @change="$store.profile.handleFileChange($event, 'banner')"
                               accept="image/*"
                               class="mt-1 block w-full text-sm text-gray-500
                                      file:mr-4 file:py-2 file:px-4
                                      file:rounded-full file:border-0
                                      file:text-sm file:font-semibold
                                      file:bg-primary file:text-white
                                      hover:file:bg-primary-dark">
                    </div>

                    {{!-- Botones --}}
                    <div class="mt-5 sm:mt-6 sm:grid sm:grid-cols-2 sm:gap-3">
                        <button type="button"
                                @click="$store.profile.cancelEditing()"
                                class="inline-flex justify-center w-full rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary sm:text-sm">
                            Cancelar
                        </button>
                        <button type="submit"
                                :disabled="$store.profile.isLoading || !$store.profile.usernameAvailable"
                                class="inline-flex justify-center w-full rounded-md border border-transparent shadow-sm px-4 py-2 bg-primary text-base font-medium text-white hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary sm:text-sm disabled:opacity-50 disabled:cursor-not-allowed">
                            <template x-if="$store.profile.isLoading">
                                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            </template>
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Inicializar datos del perfil de forma segura
    window.PROFILE_DATA = {{{ PROFILE_DATA }}};
</script>
