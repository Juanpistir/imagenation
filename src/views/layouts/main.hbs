<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - Imagenation</title>
    

    {{!-- Firebase CDN --}}
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    <script src="/public/js/firebaseClient.js"></script>

    {{!-- CSS --}}
    <link rel="stylesheet" href="/public/css/loading.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    
    {{!-- Favicon --}}
    <link rel="icon" type="image/x-icon" href="/public/favicon.ico">

    {{!-- Alpine.js y otras dependencias desde CDN --}}
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/timeago.js@4.0.2/dist/timeago.min.js"></script>
    <script src="/public/js/authAlpine.js"></script>
    <script src="/public/js/profileAlpine.js"></script>


    {{!-- Pasar datos del usuario al cliente --}}
    <script>
        const USER_JSON = JSON.parse(`{{{json user}}}`);
    </script>


</head>
<body>
    {{> navbar user=user }}
    
    <main class="container mx-auto px-4 py-8">
        {{{body}}}
    </main>

    {{> footer}}
</body>
</html>