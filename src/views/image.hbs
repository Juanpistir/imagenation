<script>
    window.IMAGE_DATA = {
        id: "{{image.id}}",
        likes: {{image.likes}},
        hasLiked: {{#if image.hasLiked}}true{{else}}false{{/if}},
        comments: {{{json image.comments}}},
        isOwner: {{#if image.isOwner}}true{{else}}false{{/if}}
    };
</script>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12" 
     x-data="imageActions('{{image.id}}', '{{image.url}}')"
     x-init="init()">
    <!-- Imagen principal -->
    <div class="relative p-8">
        <img src="{{image.mainImageUrl}}" 
             alt="{{image.title}}" 
             class="w-full max-h-[70vh] object-contain">
        
        <!-- Botones de acción -->
        {{#if user}}
            {{#if image.isOwner}}
                <div class="flex space-x-2">
                    <button @click="$store.image.editImage('{{image.id}}', '{{image.title}}', `{{image.description}}`)" 
                            class="inline-flex items-center px-3 py-2 border border-primary text-sm font-medium rounded-md text-primary hover:bg-primary hover:text-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary"
                            :disabled="$store.image.isLoading">
                        <i class="fas fa-edit mr-2"></i>
                        <span x-text="$store.image.isLoading ? 'Guardando...' : 'Editar'"></span>
                    </button>
                    <button @click="$store.image.deleteImage('{{image.id}}')"
                            class="inline-flex items-center px-3 py-2 border border-red-500 text-sm font-medium rounded-md text-red-500 hover:bg-red-500 hover:text-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
                            :disabled="$store.image.isLoading">
                        <i class="fas fa-trash-alt mr-2"></i>
                        <span x-text="$store.image.isLoading ? 'Eliminando...' : 'Eliminar'"></span>
                    </button>
                </div>
            {{/if}}
        {{/if}}
    </div>

    <!-- Información de la imagen -->
    <div class="p-8">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-2xl font-bold text-gray-900">{{image.title}}</h3>
        </div>

        <div class="flex items-center text-gray-600 text-sm mb-4">
            {{#if image.userPhotoURL}}
                <img class="h-10 w-10 rounded-full object-cover mr-2"
                     src="{{image.userPhotoURL}}"
                     alt="{{image.userDisplayName}}">
            {{else}}
                {{#if image.userDisplayName}}
                    <div class="h-10 w-10 rounded-full bg-primary text-white flex items-center justify-center font-medium uppercase mr-2">
                        {{firstChar image.userDisplayName}}
                    </div>
                {{else}}
                    <div class="h-10 w-10 rounded-full bg-gray-200 flex items-center justify-center mr-2">
                        <i class="fas fa-user text-gray-500"></i>
                    </div>
                {{/if}}
            {{/if}}
            <span>{{image.userEmail}}</span>
            <span class="mx-2">•</span>
            <i class="far fa-clock mr-2"></i>
            <span>{{timeago image.timestamp}}</span>
        </div>

        {{#if image.description}}
            <p class="text-gray-700 mb-6">{{image.description}}</p>
        {{/if}}

        <!-- Acciones -->
        <div class="flex justify-between items-center py-4 border-t border-gray-100">
            <div class="flex items-center space-x-4">
                <template x-if="$store.auth.isAuthenticated">
                    {{! Botón de colecciones }}
                    <button 
                      @click="openCollectionModal()"
                      class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded"
                    >
                      💾 Guardar en colección
                    </button>
                </template>
            </div>
        </div>

        <!-- Estadísticas -->
        <div class="flex justify-between items-center py-4 border-t border-gray-100">
            <div class="flex items-center space-x-6">
                <button 
                    @click="toggleLike"
                    class="flex items-center text-gray-600 hover:text-red-500 transition like-button"
                    :class="{ 'text-red-500': isLiked }"
                    :disabled="isLoading">
                    <i class="fas fa-heart mr-2"></i>
                    <span x-text="likesCount"></span> Me gusta
                </button>
                <button @click="focusComment" 
                        class="flex items-center text-gray-600">
                    <i class="fas fa-comment mr-2"></i>
                    <span>{{image.comments.length}} Comentarios</span>
                </button>
                <div class="flex items-center text-gray-600">
                    <i class="fas fa-eye mr-2"></i>
                    <span>{{image.views}} Vistas</span>
                </div>
                <button @click="shareImage" 
                        class="text-gray-600 hover:text-primary transition">
                    <i class="fas fa-share-alt"></i>
                </button>
            </div>
            
            <div class="flex items-center space-x-4">
                {{#if user}}
                <button class="text-gray-600 hover:text-primary transition" onclick="shareImage('{{image.url}}')">
                    <i class="fas fa-share-alt text-xl"></i>
                </button>
                {{/if}}
            </div>
        </div>

        <!-- Sección de Comentarios -->
        <div class="mt-8 border-t border-gray-200 pt-8">
            <h3 class="text-lg font-semibold text-gray-900 mb-6">Comentarios</h3>

            <!-- Formulario de Comentario -->
            <template x-if="$store.auth.isAuthenticated">
                <div class="mb-6">
                    <div class="flex space-x-4">
                        <div class="flex-grow">
                            <textarea
                                x-model="$store.image.commentText"
                                placeholder="Escribe un comentario..."
                                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary"
                                rows="2"
                            ></textarea>
                        </div>
                        <button
                            @click="$store.image.submitComment('{{image.id}}')"
                            :disabled="$store.image.isLoading || !$store.image.commentText.trim()"
                            class="px-4 py-2 bg-primary text-white rounded-md hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary disabled:opacity-50"
                        >
                            <span x-text="$store.image.isLoading ? 'Enviando...' : 'Comentar'"></span>
                        </button>
                    </div>
                </div>
            </template>

            <template x-if="!$store.auth.isAuthenticated">
                <div class="bg-gray-50 rounded-lg p-4 text-center mb-8">
                    <p class="text-gray-600">
                        <a href="/auth/login" class="text-primary hover:text-primary-dark">Inicia sesión</a>
                        para dejar un comentario
                    </p>
                </div>
            </template>

            <!-- Lista de Comentarios -->
            <div id="commentsList" class="space-y-6">
                {{#each image.comments}}
                <div class="bg-white p-4 rounded-lg shadow mb-4 hover:shadow-lg transition-shadow duration-200" 
                     data-comment="{{this.id}}">
                    <div class="flex justify-between items-start">
                        <div class="flex-grow">
                            <div class="flex items-center gap-2 mb-2">
                                <div class="h-8 w-8 rounded-full bg-primary/10 flex items-center justify-center">
                                    <i class="fas fa-user text-primary"></i>
                                </div>
                                <div>
                                    <p class="font-medium text-gray-900">{{this.userEmail}}</p>
                                    <p class="text-xs text-gray-500">{{timeago this.timestamp}}</p>
                                </div>
                            </div>
                            <p class="text-gray-600 mt-1">{{this.text}}</p>
                        </div>
                        {{#if (or (eq this.userId user.uid) (eq image.userId user.uid))}}
                        <button @click="$store.image.deleteComment('{{image.id}}', '{{this.id}}')" 
                                class="text-red-500 hover:text-red-600"
                                :disabled="$store.image.isLoading">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                        {{/if}}
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        {{#if user}}
        <!-- Modal de Colecciones -->
        <div 
          x-show="showCollectionModal"
          @click.away="closeCollectionModal()"
          class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50"
          x-cloak
        >
          <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white" @click.stop>
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg font-medium text-gray-900">Administrar colecciones</h3>
              <button @click="closeCollectionModal()" class="text-gray-500 hover:text-gray-700">
                <i class="fas fa-times"></i>
              </button>
            </div>
            
            <!-- Formulario de nueva colección -->
            <form @submit.prevent="createCollection()" class="mb-4">
              <div class="mb-4">
                <input 
                  type="text" 
                  x-model="newCollectionName"
                  placeholder="Nombre de la colección"
                  class="w-full px-3 py-2 border rounded-md"
                  required
                >
              </div>
              <div class="mb-4">
                <textarea 
                  x-model="newCollectionDescription"
                  placeholder="Descripción (opcional)"
                  class="w-full px-3 py-2 border rounded-md"
                  rows="3"
                ></textarea>
              </div>
              <button 
                type="submit"
                class="w-full bg-blue-500 text-white py-2 px-4 rounded-md hover:bg-blue-600"
                :disabled="isLoading"
              >
                <span x-text="isLoading ? 'Creando...' : 'Crear colección'"></span>
              </button>
            </form>
          </div>
        </div>
        {{/if}}
    </div>
</div>