<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2>{{image.title}}</h2>
    <button class="btn btn-danger" id="btn-delete" data-id="{{image.id}}">
      <i class="fa fa-times"></i> Eliminar
    </button>
  </div>
  <div class="card-body">
    <img src="{{image.imageUrl}}" alt="{{image.title}}" class="img-fluid">
  </div>
  <div class="card-footer">
    <div class="row">
      <button class="btn btn-success" id="btn-like" data-id="{{image.filename}}">
        <i class="fas fa-thumbs-up"></i>
        Me gusta
      </button>
      <p>
        <span class="likes-count">{{image.likes}}</span>
        <i class="fas fa-heart"></i>
      </p>
      <p>
        <i class="fas fa-eye"></i>{{image.views}}
      </p>
      <p>
        <i class="fas fa-clock"></i>{{timeago image.timestamp}}
      </p>
    </div>
  </div>
</div>

<div class="card mt-2">
  <div class="card-header acomodar">
    <h3>Comentarios</h3>
    <button class="btn btn-info" id="btn-toggle-comment"><i
        class="fa fa comment-0"
      ></i>Haz un comentario</button>
  </div>
  <div class="card-body">
    <blockquote id="post-comment">
      <form action="/images/{{image.id}}/comment" method="post">
        <div class="form-group">
          <input
            type="text"
            class="form-control mb-2"
            name="name"
            placeholder="Tu nombre"
          />
        </div>
        <div class="form-group">
          <input
            type="text"
            class="form-control mb-2"
            name="email"
            placeholder="Tu correo"
          />
        </div>
        <div class="form-group">
          <textarea
            type="text"
            class="form-control mb-2"
            rows="2"
            placeholder="Tu comentario"
            name="comment"
          ></textarea>
        </div>
        <div class="form-group">
          <button class="btn btn-success" id="btn-comment">
            <i class="fa fa-comment"></i>Publicar</button>
        </div>
      </form>
    </blockquote>
    <ul class="list-group">
      {{#each comments}}
        <li class="list-group-item">
          <div class="row">
            <a href="#" class="col text-center">
              <img
                src="http://gravatar.com/avatar/{{gravatar}}?d=identicon&s=75"
                alt=""
                class="img-fluid"
              />
            </a>
            <div class="col-10">
              <p class="lead">{{comment}}</p>
              <footer class="blockquote-footer row">
                {{name}}
                -
                {{timeago timestamp}}
              </footer>
            </div>
          </div>
        </li>
      {{/each}}
    </ul>
  </div>
</div>